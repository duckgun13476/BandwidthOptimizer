{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.PinkCats.bandwidthoptimizer.Bandwidthoptimizer"
    ],
    "client": [
      "com.PinkCats.bandwidthoptimizer.BandwidthOptimizerFabricClient"
    ]
  },
  "mixins": [
    "bandwidthoptimizer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": ">=${fabric_api_version}",
    "torqueapi": "*"
  }
}
